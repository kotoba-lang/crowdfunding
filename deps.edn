{:paths ["src"]
 ;; Every dep is an existing kotoba-lang capability this library COMPOSES
 ;; rather than reimplements (ADR-2607268500 D2), the discipline
 ;; `kotoba-lang/marketplace` established. All are portable `.cljc` with
 ;; no network I/O, so this library stays pure. The :local/root paths
 ;; resolve inside the monorepo checkout; a standalone fork should
 ;; override them with git coordinates.
 :deps {;; integer split allocation with dust-to-the-first-party — the
        ;; tranche split in crowdfunding.payout. Zero custody, zero
        ;; network: that boundary is preserved all the way up.
        io.github.kotoba-lang/pay         {:git/url "https://github.com/kotoba-lang/pay.git"
                                     :git/sha "6fd2874df910aefec66f4d3237887fe3372ca44b"}
        ;; escrow states/transitions, payout destinations and the
        ;; fee-schedule shape. A crowdfunding payout is a different
        ;; problem from a marketplace payout (paid before shipping, not
        ;; after), but the destination and escrow primitives are the same
        ;; ones and forking them would fork the audit story too.
        io.github.kotoba-lang/marketplace {:git/url "https://github.com/kotoba-lang/marketplace.git"
                                     :git/sha "57fc7b3aedcc7d0c6ffb48ac9d4fff1bdf4c6e78"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; Runtime priority (CLAUDE.md): the same portable .cljc suite under a
  ;; real ClojureScript host. Nothing in this library is JVM-only.
  :cljs {:extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
                      thheller/shadow-cljs {:mvn/version "2.28.20"}}}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}